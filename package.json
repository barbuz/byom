    "@vitest/coverage-v8": "^2.1.9",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.1.0",
    "jsdom": "^30.0.1",
    "svelte": "^4.2.8",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "maplibre-gl": "^4.0.0",
    "transformation-matrix": "^3.1.0"
  },
  "overrides": {
    "undici": "6.19.8"
